---
// src/pages/projects.astro
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Portfolio Website",
    description: "Personal landing page and project showcase built with Astro, hosted on Cloudflare Workers, and connected to GitHub CI/CD automation.",
    image: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80",
    tags: ["Astro", "JavaScript", "Cloudflare", "HTML/CSS"],
    github: "https://github.com/luke-trlin/luketrlin-public-website",
    status: "Active"
  },
  {
    title: "Weed Stalker RC Boat",
    description: "High-performance remote-controlled watercraft engineered with dual-battery configurations and precise buoyancy math for university design competition.",
    image: "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80",
    tags: ["Engineering Design", "Hardware", "CAD", "Calculations"],
    github: "",
    status: "Completed"
  },
  {
    title: "Portable Baby Food Heater",
    description: "Thermal design project exploring exothermic chemical reactions and electrical heating mechanisms for safe infant food warming.",
    image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80",
    tags: ["Thermal Physics", "Chemical Design", "Product Design"],
    github: "",
    status: "Concept"
  }
];
---

<Layout title="Projects | Luke Trlin">
  <main class="projects-page">
    <header class="page-header">
      <h1>Projects & Technical Work</h1>
      <p>A breakdown of software applications, engineering prototypes, and technical coursework.</p>
    </header>

    <div class="grid">
      {projects.map((project) => (
        <article class="card">
          <div class="card-image-container">
            <img src={project.image} alt={project.title} class="card-image" />
            <span class={`status-tag ${project.status.toLowerCase()}`}>{project.status}</span>
          </div>
          <div class="card-body">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="project-link">
                View Source Code &rarr;
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  .projects-page {
    padding: 2rem 0;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--card-border);
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card-image-container {
    position: relative;
    width: 100%;
    height: 180px;
    background-color: #1e293b;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .card-image {
    transform: scale(1.05);
  }

  .status-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status-tag.active {
    background: rgba(34, 197, 94, 0.85);
    color: #fff;
  }

  .status-tag.completed {
    background: rgba(56, 189, 248, 0.85);
    color: #000;
  }

  .status-tag.concept {
    background: rgba(168, 85, 247, 0.85);
    color: #fff;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-body h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .card-body p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tag {
    background: #1e293b;
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .project-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: auto;
  }

  .project-link:hover {
    text-decoration: underline;
  }
</style>