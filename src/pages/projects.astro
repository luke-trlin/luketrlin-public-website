---
// src/pages/projects.astro
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Portfolio Website",
    description: "Personal portfolio built with Astro, hosted on Cloudflare Workers, and managed via GitHub.",
    tags: ["Astro", "JavaScript", "Cloudflare"],
    link: "https://github.com/luke-trlin/luketrlin-public-website"
  },
  {
    title: "Weed Stalker RC Boat",
    description: "High-performance remote-controlled watercraft engineered with custom buoyancy calculations and dual battery setups.",
    tags: ["Engineering Design", "Hardware", "CAD"],
    link: ""
  },
  {
    title: "Baby Food Heater Concept",
    description: "Portable exothermic and electrical heating mechanism conceptualized for baby food temperature regulation.",
    tags: ["Thermal Analysis", "Chemical Design"],
    link: ""
  }
];
---

<Layout title="Projects | Luke Trlin">
  <main class="projects-page">
    <header class="page-header">
      <h1>All Projects</h1>
      <p>A collection of software applications, engineering prototypes, and technical projects.</p>
    </header>

    <div class="grid">
      {projects.map((project) => (
        <div class="card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          {project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link">
              View Code &rarr;
            </a>
          )}
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .projects-page {
    padding: 2rem 0;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: #1e293b;
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .project-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: auto;
  }

  .project-link:hover {
    text-decoration: underline;
  }
</style>