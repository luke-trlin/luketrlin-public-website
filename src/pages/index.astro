---
// src/pages/index.astro
const pageTitle = "Luke Trlin | Software Engineering Student";
const email = "luke@luketrlin.com";
const github = "https://github.com/luke-trlin";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <span class="badge">Software Engineering Student</span>
        <h1>Luke Trlin</h1>
        <p class="subtitle">Building software, designing hardware, and exploring technology.</p>
        
        <div class="nav-links">
          <a href={`mailto:${email}`} class="btn btn-primary">Email Me</a>
          <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub</a>
        </div>
      </header>

      <main>
        <section>
          <h2>About Me</h2>
          <p class="about-text">
            Welcome to my personal site! I am currently studying Software Engineering, focusing on full-stack web development, software architecture, and hardware engineering projects.
          </p>
        </section>

        <section>
          <h2>Featured Projects</h2>
          <div class="grid">
            
            <div class="card">
              <h3>Portfolio Website</h3>
              <p>Personal portfolio built with Astro, hosted on Cloudflare, and integrated with GitHub CI/CD.</p>
              <div class="tags">
                <span class="tag">Astro</span>
                <span class="tag">JavaScript</span>
                <span class="tag">Cloudflare</span>
              </div>
            </div>

            <div class="card">
              <h3>Project Showcase</h3>
              <p>Future engineering showcase, application, or software tool details will go here.</p>
              <div class="tags">
                <span class="tag">C#</span>
                <span class="tag">SQL</span>
                <span class="tag">Git</span>
              </div>
            </div>

          </div>
        </section>
      </main>

      <footer>
        <p>&copy; {new Date().getFullYear()} Luke Trlin. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --bg: #0b0f19;
    --card-bg: #111827;
    --card-border: #1f2937;
    --accent: #38bdf8;
    --accent-hover: #0284c7;
    --text: #f3f4f6;
    --text-muted: #9ca3af;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .container {
    width: 90%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--card-border);
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .nav-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--accent);
    color: #000;
  }

  .btn-primary:hover {
    background-color: var(--accent-hover);
    color: #fff;
  }

  .btn-secondary {
    background-color: var(--card-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  section {
    margin: 3rem 0;
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .about-text {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: #1e293b;
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  footer {
    margin-top: auto;
    padding: 2rem 0;
    border-top: 1px solid var(--card-border);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>