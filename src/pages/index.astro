---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const email = "luke@luketrlin.com";
const github = "https://github.com/luke-trlin";

const skills = [
  "C# / .NET", "JavaScript", "Astro", "HTML/CSS", 
  "Git & GitHub", "SQL", "Embedded Systems", "CAD Design"
];
---

<Layout title="Luke Trlin | Software Engineering Student">
  <!-- Hero Section -->
  <header class="hero">
    <div class="hero-content">
      <span class="badge">Software Engineering Student</span>
      <h1>Luke Trlin</h1>
      <p class="subtitle">
        Software engineering student at the University of Waikato, focusing on full-stack web applications, embedded systems, and hardware design.
      </p>
      
      <div class="hero-links">
        <a href={`mailto:${email}`} class="btn btn-primary">Email Me</a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub</a>
        <a href="/projects" class="btn btn-accent">Explore Projects &rarr;</a>
      </div>
    </div>
  </header>

  <main>
    <!-- About Section -->
    <section class="about-section">
      <div class="section-header">
        <h2>About Me</h2>
        <div class="divider"></div>
      </div>
      <p class="about-text">
        I am currently pursuing my degree in Software Engineering, combining a strong foundation in core computer science principles with hands-on physical engineering and system design. My focus ranges from high-level web architecture to low-level microcontroller integration and rapid prototyping.
      </p>

      <div class="skills-wrapper">
        <h3>Technical Focus & Toolkit</h3>
        <div class="skills-grid">
          {skills.map((skill) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Projects Teaser -->
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Work</h2>
        <a href="/projects" class="view-all-link">View All Projects &rarr;</a>
      </div>

      <div class="grid">
        <div class="card">
          <div class="card-image-wrapper">
            <img 
              src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80" 
              alt="Code editor background" 
              class="card-image"
            />
          </div>
          <div class="card-content">
            <div class="card-header">
              <h3>Portfolio Website</h3>
              <span class="status-badge active">Live</span>
            </div>
            <p>Personal portfolio built with Astro and hosted on Cloudflare Workers with automated GitHub deployments.</p>
            <div class="tags">
              <span class="tag">Astro</span>
              <span class="tag">Cloudflare</span>
              <span class="tag">CI/CD</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-image-wrapper">
            <img 
              src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80" 
              alt="Hardware circuit design" 
              class="card-image"
            />
          </div>
          <div class="card-content">
            <div class="card-header">
              <h3>Weed Stalker RC Boat</h3>
              <span class="status-badge complete">Completed</span>
            </div>
            <p>A custom remote-controlled watercraft with calculated buoyancy parameters and optimized battery configurations.</p>
            <div class="tags">
              <span class="tag">Hardware</span>
              <span class="tag">CAD</span>
              <span class="tag">Engineering</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--card-border);
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 680px;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.3rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--accent);
    color: #0b0f19;
  }

  .btn-primary:hover {
    background-color: var(--accent-hover);
    color: #fff;
  }

  .btn-secondary {
    background-color: var(--card-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-accent {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text);
    border: 1px solid var(--card-border);
  }

  .btn-accent:hover {
    border-color: var(--accent);
  }

  /* Section Styling */
  section {
    margin: 3.5rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .about-text {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .skills-wrapper {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .skills-wrapper h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    background: #1e293b;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.15);
  }

  /* Featured Cards */
  .view-all-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card-image-wrapper {
    width: 100%;
    height: 160px;
    overflow: hidden;
    background-color: #1e293b;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 1.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-header h3 {
    font-size: 1.15rem;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .status-badge.active {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }

  .status-badge.complete {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: #1e293b;
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
</style>